# Dropbear SSH & SFTP Server Configuration
# Stored at /data/adb/sshserver/config.env

# Port to listen on (default: 22)
PORT=22

# Allow password authentication (1 = enabled, 0 = disabled / keys only)
ALLOW_PASSWORD=1

# Allow root login (1 = allowed, 0 = disallowed)
ALLOW_ROOT=1

# Plaintext password (will be automatically hashed on first boot, then cleared)
PASSWORD="crdroid"

# Pre-hashed SHA-512 password.
# IMPORTANT: Always use single quotes ('...') to avoid shell variable expansion ($)
# Example: PASSWORD_HASH='$6$saltsalt$hashedpassword...'
PASSWORD_HASH=''
