#!/system/bin/sh
# Control script for Dropbear SSH Server
# Author: Ayoubvvch

CONFIG_FILE="/data/adb/sshserver/config.env"
PIDFILE="/data/adb/sshserver/dropbear.pid"
HOSTKEY="/data/adb/sshserver/keys/dropbear_ed25519_host_key"
AUTH_KEYS="/data/adb/sshserver/.ssh/authorized_keys"
LOGFILE="/data/adb/sshserver/log/dropbear.log"
MKPASSWD="/data/adb/sshserver/bin/mkpasswd"

# Ensure root utilities, Magisk, and our bin folder are in PATH
export PATH=/data/adb/magisk:/data/adb/sshserver/bin:$PATH:/system/bin:/system/xbin:/vendor/bin:/apex/com.android.runtime/bin:/data/data/com.termux/files/usr/bin
export HOME=/data/adb/sshserver

# Load config
PORT=22
ALLOW_PASSWORD=1
ALLOW_ROOT=1
PASSWORD_HASH=""

if [ -f "$CONFIG_FILE" ]; then
  . "$CONFIG_FILE"
fi

PORT=${PORT:-22}
ALLOW_PASSWORD=${ALLOW_PASSWORD:-1}
ALLOW_ROOT=${ALLOW_ROOT:-1}

get_device_ip() {
  local ip=""
  ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | cut -d' ' -f2)
  if [ -z "$ip" ]; then
    ip=$(ip addr show wlan0 2>/dev/null | grep -oE 'inet [0-9.]+' | head -n 1 | cut -d' ' -f2)
  fi
  if [ -z "$ip" ]; then
    ip=$(getprop dhcp.wlan0.ipaddress 2>/dev/null)
  fi
  echo "${ip:-127.0.0.1}"
}

get_active_sessions() {
  local count=0
  if [ -f "$PIDFILE" ]; then
    local ppid
    ppid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$ppid" ]; then
      count=$(ps -A -o PPID,NAME 2>/dev/null | grep -E "^ *${ppid} +dropbear" | wc -l)
    fi
  fi
  echo "$count"
}

hash_password() {
  local pass="$1"
  local hash=""

  if [ -x "$MKPASSWD" ]; then
    hash=$("$MKPASSWD" "$pass" 2>/dev/null)
  elif which openssl >/dev/null 2>&1; then
    hash=$(openssl passwd -6 "$pass" 2>/dev/null)
  elif [ -x /data/adb/magisk/busybox ] && /data/adb/magisk/busybox --list | grep -q "^cryptpw$"; then
    hash=$(echo -n "$pass" | /data/adb/magisk/busybox cryptpw -m sha512 2>/dev/null)
  elif which busybox >/dev/null 2>&1 && busybox --list | grep -q "^cryptpw$"; then
    hash=$(echo -n "$pass" | busybox cryptpw -m sha512 2>/dev/null)
  elif which python3 >/dev/null 2>&1; then
    hash=$(python3 -c "import crypt; print(crypt.crypt('$pass', crypt.mksalt(crypt.METHOD_SHA512)))" 2>/dev/null)
  fi

  echo "$hash"
}

apply_new_hash() {
  local hash="$1"
  if [ -z "$hash" ]; then
    return 1
  fi

  # Update config.env preserving other keys
  local p="${PORT:-22}"
  local ap="${ALLOW_PASSWORD:-1}"
  local ar="${ALLOW_ROOT:-1}"

  cat <<EOF > "$CONFIG_FILE"
PORT=$p
ALLOW_PASSWORD=$ap
ALLOW_ROOT=$ar
PASSWORD_HASH='$hash'
PASSWORD=''
EOF
  chmod 600 "$CONFIG_FILE"

  # Write to systemless passwd file
  local mod_passwd="/data/adb/modules/sshserverpwd/system/etc/passwd"
  if [ -d "/data/adb/modules/sshserverpwd/system/etc" ]; then
    echo "root:$hash:0:0:root:/data/adb/sshserver:/system/bin/sh" > "$mod_passwd"
    chmod 644 "$mod_passwd"
    chown 0:0 "$mod_passwd"

    mount -o bind "$mod_passwd" /system/etc/passwd 2>/dev/null || mount -o bind "$mod_passwd" /etc/passwd 2>/dev/null || true
  fi
  return 0
}

case "$1" in
  start)
    if [ -f "$PIDFILE" ]; then
      PID=$(cat "$PIDFILE" 2>/dev/null)
      if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "SSH Server is already running (PID $PID)"
        exit 0
      fi
    fi

    if [ ! -f "$HOSTKEY" ]; then
      echo "Generating Ed25519 host key at $HOSTKEY..."
      mkdir -p "$(dirname "$HOSTKEY")"
      /data/adb/sshserver/bin/dropbearkey -t ed25519 -f "$HOSTKEY"
    fi

    mkdir -p "$(dirname "$LOGFILE")"
    ARGS="-r $HOSTKEY -p $PORT -P $PIDFILE -E -e -K 30"
    if [ "$ALLOW_PASSWORD" = "0" ]; then
      ARGS="$ARGS -s"
    fi
    if [ "$ALLOW_ROOT" = "0" ]; then
      ARGS="$ARGS -w"
    fi

    echo "Starting Dropbear SSH server on port $PORT..."
    /data/adb/sshserver/bin/dropbear $ARGS
    if [ $? -eq 0 ]; then
      echo "SSH Server started successfully."
    else
      echo "Failed to start SSH Server."
    fi
    ;;

  stop)
    if [ -f "$PIDFILE" ]; then
      PID=$(cat "$PIDFILE" 2>/dev/null)
      if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "Stopping SSH Server (PID $PID)..."
        kill "$PID"
        rm -f "$PIDFILE"
        echo "SSH Server stopped."
      else
        echo "SSH Server is not running, cleaning stale PID file."
        rm -f "$PIDFILE"
      fi
    else
      echo "SSH Server is not running."
    fi
    ;;

  restart)
    $0 stop
    sleep 1
    $0 start
    ;;

  status)
    if [ -f "$PIDFILE" ]; then
      PID=$(cat "$PIDFILE" 2>/dev/null)
      if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "SSH Server is running (PID $PID) on port $PORT."
        echo "IP: $(get_device_ip)"
        echo "Active Sessions: $(get_active_sessions)"
      else
        echo "SSH Server PID file found but process is not running (stale PID)."
      fi
    else
      echo "SSH Server is not running."
    fi
    ;;

  status-json)
    IS_RUNNING=false
    CUR_PID=0
    if [ -f "$PIDFILE" ]; then
      PID=$(cat "$PIDFILE" 2>/dev/null)
      if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        IS_RUNNING=true
        CUR_PID=$PID
      fi
    fi
    IP=$(get_device_ip)
    SESSIONS=$(get_active_sessions)
    HAS_PASSWD=false
    [ -n "$PASSWORD_HASH" ] && HAS_PASSWD=true

    cat <<EOF
{
  "running": $IS_RUNNING,
  "pid": $CUR_PID,
  "port": $PORT,
  "allow_password": $ALLOW_PASSWORD,
  "allow_root": $ALLOW_ROOT,
  "ip": "$IP",
  "sessions": $SESSIONS,
  "has_password": $HAS_PASSWD
}
EOF
    ;;

  set-config)
    NEW_PORT="${2:-$PORT}"
    NEW_AP="${3:-$ALLOW_PASSWORD}"
    NEW_AR="${4:-$ALLOW_ROOT}"

    cat <<EOF > "$CONFIG_FILE"
PORT=$NEW_PORT
ALLOW_PASSWORD=$NEW_AP
ALLOW_ROOT=$NEW_AR
PASSWORD_HASH='$PASSWORD_HASH'
PASSWORD=''
EOF
    chmod 600 "$CONFIG_FILE"
    echo "Configuration saved."
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
      echo "Restarting server to apply new settings..."
      $0 restart
    fi
    ;;

  set-password)
    NEW_PASS="$2"
    if [ -z "$NEW_PASS" ]; then
      echo "Error: Password cannot be empty."
      exit 1
    fi
    HASH=$(hash_password "$NEW_PASS")
    if [ -z "$HASH" ]; then
      echo "Error: No password hashing tool found on device."
      exit 1
    fi
    if apply_new_hash "$HASH"; then
      echo "Password successfully updated!"
    else
      echo "Error updating password."
      exit 1
    fi
    ;;

  set-hash)
    HASH="$2"
    if [ -z "$HASH" ]; then
      echo "Error: Hash cannot be empty."
      exit 1
    fi
    if apply_new_hash "$HASH"; then
      echo "Password hash successfully updated!"
    else
      echo "Error updating password hash."
      exit 1
    fi
    ;;

  get-keys)
    echo "["
    if [ -f "$AUTH_KEYS" ]; then
      FIRST=1
      INDEX=1
      while IFS= read -r line || [ -n "$line" ]; do
        trimmed=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')
        case "$trimmed" in
          \#*|"") continue ;;
        esac
        ktype=$(echo "$trimmed" | awk '{print $1}')
        kcomment=$(echo "$trimmed" | cut -d' ' -f3-)
        [ "$FIRST" -eq 1 ] && FIRST=0 || printf ',\n'
        printf '  {"index":%d,"type":"%s","comment":"%s"}' "$INDEX" "$ktype" "${kcomment:-Public Key}"
        INDEX=$((INDEX + 1))
      done < "$AUTH_KEYS"
    fi
    echo ""
    echo "]"
    ;;

  add-key)
    KEY_STR="$2"
    if [ -z "$KEY_STR" ]; then
      echo "Error: No key provided."
      exit 1
    fi
    mkdir -p "$(dirname "$AUTH_KEYS")"
    chmod 700 "$(dirname "$AUTH_KEYS")"
    echo "$KEY_STR" >> "$AUTH_KEYS"
    chmod 600 "$AUTH_KEYS"
    chown 0:0 "$AUTH_KEYS"
    echo "Public key added successfully."
    ;;

  remove-key)
    INDEX="$2"
    if [ -z "$INDEX" ] || [ ! -f "$AUTH_KEYS" ]; then
      echo "Error: Invalid index or no authorized_keys file."
      exit 1
    fi
    sed -i "${INDEX}d" "$AUTH_KEYS"
    echo "Key at index $INDEX removed."
    ;;

  get-logs)
    if [ -f "$LOGFILE" ]; then
      tail -n 60 "$LOGFILE"
    else
      echo "(No log file found at $LOGFILE)"
    fi
    ;;

  passwd)
    echo -n "Enter new root password: "
    stty -echo 2>/dev/null
    read -r NEW_PASS
    stty echo 2>/dev/null
    echo ""

    echo -n "Confirm new root password: "
    stty -echo 2>/dev/null
    read -r CONFIRM_PASS
    stty echo 2>/dev/null
    echo ""

    if [ "$NEW_PASS" != "$CONFIRM_PASS" ]; then
      echo "Error: Passwords do not match!"
      exit 1
    fi

    $0 set-password "$NEW_PASS"
    ;;

  *)
    echo "Usage: sshserverctl {start|stop|restart|status|status-json|set-config|set-password|set-hash|get-keys|add-key|remove-key|get-logs|passwd}"
    exit 1
    ;;
esac
